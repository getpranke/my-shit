-- ESP scan helpers
local function shouldShowESP(roomNumber)
    local currentRoom = LocalPlayer:GetAttribute("CurrentRoom")
    if not currentRoom then return false end
    return roomNumber == currentRoom or roomNumber == currentRoom + 1
end

local function makeESP(obj, text, color)
    if not obj or not obj.Parent then return nil end
    local ok, esp = pcall(function()
        return ESPLibrary:Add({
            Name = text, Model = obj, Color = color, MaxDistance = 1000,
            TextSize = ESPGlobalSettings.TextSize, ESPType = ESPGlobalSettings.ESPType,
            FillColor = color, OutlineColor = color,
            FillTransparency = ESPGlobalSettings.FillTransparency,
            OutlineTransparency = ESPGlobalSettings.OutlineTransparency,
            Tracer = { Enabled = true, Color = color, From = "Bottom" },
            Arrow = { Enabled = true, Color = color },
        })
    end)
    if ok and esp then esp:Show() return esp end
    return nil
end

