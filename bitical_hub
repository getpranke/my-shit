    end
    if Toggles.AutoInteract and Toggles.AutoInteract.Value then
        if v and not Ignore[v.Name] and v:IsA("ProximityPrompt") then table.insert(AutoInteractTable, v) end
    end
    if v:IsA("ProximityPrompt") and Toggles.PromptReach.Value then
        v:SetAttribute("Distance", v.MaxActivationDistance)
        v.MaxActivationDistance = v.MaxActivationDistance * promptReachMultiplier
    end
    if Toggles.AntiLag and Toggles.AntiLag.Value then
        if v:IsA("BasePart") then v.Material = Enum.Material.Plastic end
        if v.Name == "LightFixture" or v.Name == "Carpet" or v.Name == "CarpetLight" then v:Destroy() end
    end
    if Toggles.AntiSeekObstructions and Toggles.AntiSeekObstructions.Value then
        if v.Name == "ChandelierObstruction" or v.Name == "Seek_Arm" then
            for _, part in ipairs(v:GetChildren()) do
                if part:IsA("BasePart") then part.CanTouch = false end
            end
        end
    end
    if Toggles.AntiBanana and Toggles.AntiBanana.Value then
        if v.Name == "BananaPeel" or v.Name == "NannerPeel" then
            if v:IsA("BasePart") then v.CanTouch = false end
        end
    end
    if Toggles.AntiKillbricks and Toggles.AntiKillbricks.Value then
        if v.Name == "Lava" and v:IsA("BasePart") then v.CanTouch = false end
    end
    if Toggles.AntiSeekingWall and Toggles.AntiSeekingWall.Value then
        if v.Name == "ScaryWall" and v:IsA("Model") then
            for _, part in ipairs(v:GetDescendants()) do
                if part:IsA("BasePart") then part.CanTouch = false part.CanCollide = false end
            end
        end
    end
    if Toggles.AntiGiggle and Toggles.AntiGiggle.Value then
        if v.Name == "GiggleCeiling" then
            local hb = v:FindFirstChild("Hitbox")
            if hb then hb.CanTouch = false end
        end
    end
end))

function Unload()
    addonLoaded = false
    for _, name in ipairs({
        "EnableSlide","AutoCloset","SpectateEntity","AutoAnchorSolver","AutoSteerMinecart",
        "AnticheatBypass","DeleteFigure","DeleteMinecart","AntiSeekFlood",
        "ABF","AntiKillbricks","ShowSeekPath","TeleportToNextRoom","AntiVacuum","AntiLookman",
        "AntiDupe","ShowEyestalkPath","AntiGloombatEggs","AntiGiggle","AntiJeff","AntiBanana",
        "AntiSeekObstructions","AntiSeekingWall","AntiSurge","FigureGodmode","NoPuzzleDoors",
        "CrouchSpoof","VelocityManipulation","NotifyItemsToggle","AntiA90","AntiJam","AntiGloomPile",
        "DoorSkipper","DisableMinesEcho","CollisionOffsetGodmodeAlt","NoSpread","FastThrow",
        "SlideSpeedHack","Freecam","NoWardrobeVignette","RemoveAmbience","ReplaceGLwG",
        "CurrentHideTime","HidingRoomNotify","InvisibleGrumbles","AntiGroundskeeper","ThinkingAnimation",
        "AnticheatManipulation"
    }) do
        if Toggles[name] then pcall(function() Toggles[name]:SetValue(false) end) end
    end
    if FakeSurge then FakeSurge:Destroy() end
    if ReplicatedStorage:FindFirstChild("SurgeRemote") then
        ReplicatedStorage.SurgeRemote.Parent = ReplicatedStorage.RemotesFolder
    end
    for _, connection in ipairs(Connections) do
        if connection and connection.Connected then pcall(function() connection:Disconnect() end) end
    end
    Connections = {}
    if Fly and Fly.Enabled then Fly.Disable() end
    AutoInteractTable = {}
    pcall(function() RunService:UnbindFromRenderStep("THIRD_PERSON_SYS") end)
    pcall(function() RunService:UnbindFromRenderStep("FOV_SYS") end)
    pcall(function() RunService:UnbindFromRenderStep("GOD_MODE_CAMERA_SYS") end)
    if AnticheatManipulationLoop then pcall(function() task.cancel(AnticheatManipulationLoop) end) end
    LocalPlayer:SetAttribute("SapphireLoaded", nil)
    Library:Unload()
    if ESPLibrary then pcall(function() ESPLibrary:Unload() end) end
    if RemoteFolder:FindFirstChild("Crouch") then RemoteFolder.Crouch:FireServer(false) end
end

