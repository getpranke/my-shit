local PL = nil; local UnlockDistance = 40
Automation:AddToggle('AutoCodeFire', { Text = "Auto Unlock Padlock", Default = false,
    Callback = function(on)
        if on then
            PL = ReplicatedStorage.RemotesFolder:FindFirstChild("PL")
            if not PL then LogWarn("Padlock remote missing"); Toggles.AutoCodeFire:SetValue(false); return end
            while ReplicatedStorage.GameData.LatestRoom.Value < 50 do
                task.wait(0.4); if not Toggles.AutoCodeFire.Value then return end
            end
            local seenPapers, lastCodes, lastFireTimes = {}, {}, {}
            local padPart = nil
            local function updatePad()
                local idx = ReplicatedStorage.GameData.LatestRoom.Value
                local rr = workspace.CurrentRooms and workspace.CurrentRooms[idx]
                if rr then
                    local pad = rr:FindFirstChild("Padlock", true)
                    padPart = pad and (pad.PrimaryPart or pad:FindFirstChildWhichIsA("BasePart"))
                else padPart = nil end
            end
            local function parsePaper(paper, hints)
                local children = paper:WaitForChild("UI"):GetChildren()
                local map, order = {}, {}
                for i = 1, #children do
                    local c = children[i]; local idx = tonumber(c.Name)
                    if idx then
                        local key = c.ImageRectOffset.X .. "_" .. c.ImageRectOffset.Y
                        map[key] = { idx, "" }; order[idx] = key
                    end
                end
                if hints then
                    for _, ic in ipairs(hints:GetChildren()) do
                        if ic.Name == "Icon" then
                            local key = ic.ImageRectOffset.X .. "_" .. ic.ImageRectOffset.Y
                            local e = map[key]
                            if e then
                                local lbl = ic:FindFirstChildWhichIsA("TextLabel")
                                if lbl then e[2] = lbl.Text end
                            end
                        end
                    end
                end
                local parts = {}
                for i = 1, #order do parts[i] = map[order[i]][2] end
                return table.concat(parts)
            end
            local function handleCode(paper)
                local hints = LocalPlayer.PlayerGui:FindFirstChild("PermUI") and LocalPlayer.PlayerGui.PermUI:FindFirstChild("Hints")
                local code = parsePaper(paper, hints)
                if lastCodes[paper] ~= code and code ~= "" then
                    lastCodes[paper] = code
                    if padPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local d = (LocalPlayer.Character.HumanoidRootPart.Position - padPart.Position).Magnitude
                        if d <= UnlockDistance then
                            local now = tick()
                            if not lastFireTimes[code] or now - lastFireTimes[code] > 1 then
                                local ok = pcall(function() if PL then PL:FireServer(code) end end)
                                if ok then lastFireTimes[code] = now end
                            end
                        end
                    end
                end
            end
            local function addPaper(paper)
                if seenPapers[paper] then return end
                seenPapers[paper] = true
                table.insert(Connections, paper.DescendantAdded:Connect(function() handleCode(paper) end))
                table.insert(Connections, paper.DescendantRemoving:Connect(function() handleCode(paper) end))
                handleCode(paper)
            end
            local function scan(c)
                for _, o in ipairs(c:GetChildren()) do
                    if o.Name == "LibraryHintPaper" or o.Name == "LibraryHintPaperHard" then addPaper(o) end
                end
            end
            updatePad()
            table.insert(Connections, ReplicatedStorage.GameData.LatestRoom:GetPropertyChangedSignal("Value"):Connect(updatePad))
            scan(LocalPlayer.Character); scan(LocalPlayer.Backpack)
            table.insert(Connections, LocalPlayer.Backpack.ChildAdded:Connect(function(obj)
                if obj.Name == "LibraryHintPaper" or obj.Name == "LibraryHintPaperHard" then addPaper(obj) end
            end))
            table.insert(Connections, LocalPlayer.CharacterAdded:Connect(function(c) task.wait(1); scan(c) end))
        end
    end
})
