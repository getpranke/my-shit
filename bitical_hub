                    end
                end
            end
        else
            for model in pairs(DoorESPObjects) do Abysall.ESPLibrary:RemoveESP(model) end
            DoorESPObjects = {}
        end
    end
}):AddColorPicker('DoorColor', { Default = DoorColor, Title = 'Door Color', Transparency = 0,
