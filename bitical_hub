function Unload()
    LocalPlayer:SetAttribute("SapphireLoaded", nil)
    if renderConn then renderConn:Disconnect() end
    if InfiniteCrucifixConnection then InfiniteCrucifixConnection:Disconnect() end
    for _, c in ipairs(Connections) do
        if typeof(c) == "RBXScriptConnection" then pcall(function() c:Disconnect() end)
        elseif type(c) == "table" and c.Disconnect then pcall(function() c:Disconnect() end) end
    end
    for _, tbl in ipairs({ DoorESPObjects, ObjectiveESPObjects, CurrencyESPObjects, EntityESPObjects, LadderESPObjects, ChestESPObjects, PlayerESPObjects, ItemsESPObjects, HidingSpotESPObjects }) do
        for _, obj in pairs(tbl) do pcall(function() obj:Destroy() end) end
    end
    if Character and Character:FindFirstChild("Humanoid") then
        Character.Humanoid.WalkSpeed = 16
        Character.Humanoid.JumpPower = 50
        Character.Humanoid.HipHeight = 2.367
    end
    if Character then
        if Character:FindFirstChild("_CollisionPart") then Character._CollisionPart:Destroy() end
        if Character:FindFirstChild("_CollisionPart2") then Character._CollisionPart2:Destroy() end
    end
    if RemoteFolder and RemoteFolder:FindFirstChild("Crouch") then
        RemoteFolder.Crouch:FireServer(false)
    end
    if SeekNodeFolder then SeekNodeFolder:Destroy() end
    if oxygenNotifyUI then oxygenNotifyUI:Destroy() end
    if hasteUI then hasteUI:Destroy() end
    pcall(function() RunService:UnbindFromRenderStep("THIRD_PERSON_SYS") end)
    pcall(function() RunService:UnbindFromRenderStep("FOV_SYS") end)
    Library:Unload()
end

SettingsBox:AddButton({ Text = "Unload Script", Func = function() Unload() end })

