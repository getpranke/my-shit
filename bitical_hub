            elseif name == "SkeletonKey" then label = "Skeleton Key"
            elseif name == "Crucifix" or name == "CrucifixWall" then label = "Crucifix"
            elseif name == "Shears" then label = "Shears"
            elseif name == "Lighter" then label = "Lighter"
            elseif name == "Vitamins" then label = "Vitamins"
            end
            if label then AddESP(v, label, Options.ESP_ItemsColor.Value) end
        end
    end
end)

