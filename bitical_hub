    if not door or not door.Parent then return end
    local model = door
    if door:IsA("BasePart") and door.Parent and door.Parent:IsA("Model") then model = door.Parent end
    if door.Name == "Door" and door.Parent and door.Parent.Name == "Door" then model = door end
    if DoorESPObjects[model] then DoorESPObjects[model]:Hide() end
    local displayText = "Door " .. (door.Parent:GetAttribute("RoomID") or roomNumber)
    local espObject = makeESP(model, displayText, DoorColor)
    if espObject then
        DoorESPObjects[model] = espObject
    end
end
