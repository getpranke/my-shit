-- FLOOR VISIBILITY MANAGER
-- Hides groupboxes for floors that aren't the current floor.
-- Uses multiple access patterns to support Linoria/Obsidian.
-- ═══════════════════════════════════════════════════════════════
local function setGroupboxVisible(groupbox, visible)
    if not groupbox then return end
    -- Try all known patterns
    pcall(function()
        if groupbox.Frame and groupbox.Frame.Visible ~= visible then
            groupbox.Frame.Visible = visible
        end
    end)
    pcall(function()
        if groupbox.Holder and groupbox.Holder.Visible ~= visible then
            groupbox.Holder.Visible = visible
        end
    end)
    pcall(function()
        if groupbox.Groupbox and groupbox.Groupbox.Visible ~= visible then
            groupbox.Groupbox.Visible = visible
        end
    end)
    -- Fallback: iterate through UIElements and hide their parent frame
    pcall(function()
        if groupbox.UIElements and next(groupbox.UIElements) then
            local first = next(groupbox.UIElements)
            if first then
                local f = first
                while f and f.Parent and f.Parent ~= game:GetService("CoreGui") do
                    if f:IsA("Frame") and f.Name == "Groupbox" or f.Name == "GroupBox" then
                        f.Visible = visible
                        break
                    end
                    f = f.Parent
                end
            end
        end
    end)
end

