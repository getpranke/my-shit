local function CreateStatsGui()
    if Stats.Gui then return end

    local gui = Instance.new("ScreenGui")
    gui.Name = "BiticalStats"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.IgnoreGuiInset = true
    gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")

    local frame = Instance.new("Frame")
    frame.Name = "StatsFrame"
    frame.Size = UDim2.new(0, 130, 0, 60)
    frame.Position = Stats.Position
    frame.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(70, 70, 80)
    stroke.Thickness = 1
    stroke.Transparency = 0.4
    stroke.Parent = frame

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 6)
    padding.PaddingBottom = UDim.new(0, 6)
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 10)
    padding.Parent = frame

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)
    layout.Parent = frame

    local fpsLabel = Instance.new("TextLabel")
    fpsLabel.Name = "FPS"
    fpsLabel.Size = UDim2.new(1, 0, 0, 20)
    fpsLabel.BackgroundTransparency = 1
    fpsLabel.Text = "FPS: --"
    fpsLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
    fpsLabel.TextSize = 14
    fpsLabel.Font = Enum.Font.GothamMedium
    fpsLabel.TextXAlignment = Enum.TextXAlignment.Left
    fpsLabel.LayoutOrder = 1
    fpsLabel.Parent = frame

    local pingLabel = Instance.new("TextLabel")
    pingLabel.Name = "Ping"
    pingLabel.Size = UDim2.new(1, 0, 0, 20)
    pingLabel.BackgroundTransparency = 1
    pingLabel.Text = "Ping: -- ms"
    pingLabel.TextColor3 = Color3.fromRGB(120, 200, 255)
    pingLabel.TextSize = 14
    pingLabel.Font = Enum.Font.GothamMedium
    pingLabel.TextXAlignment = Enum.TextXAlignment.Left
    pingLabel.LayoutOrder = 2
    pingLabel.Parent = frame

    local dragging, dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        Stats.Position = frame.Position
    end

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end))

    Stats.Gui = gui
    Stats.Frame = frame
    Stats.FPSLabel = fpsLabel
    Stats.PingLabel = pingLabel
end

local function UpdateStats()
    if not Stats.Visible then return end

    Stats.FrameCount += 1
    local now = tick()
    if now - Stats.LastTime >= 1 then
        Stats.FPS = math.floor(Stats.FrameCount / (now - Stats.LastTime))
        Stats.FrameCount = 0
        Stats.LastTime = now

        local fpsColor
        if Stats.FPS >= 50 then fpsColor = Color3.fromRGB(120, 255, 120)
        elseif Stats.FPS >= 30 then fpsColor = Color3.fromRGB(255, 220, 100)
        else fpsColor = Color3.fromRGB(255, 90, 90) end
        Stats.FPSLabel.Text = "FPS: " .. Stats.FPS
        Stats.FPSLabel.TextColor3 = fpsColor
    end

    local ok, ping = pcall(function()
        return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and ping then
        Stats.Ping = math.floor(ping)
        local pingColor
        if Stats.Ping <= 80 then pingColor = Color3.fromRGB(120, 255, 120)
        elseif Stats.Ping <= 150 then pingColor = Color3.fromRGB(255, 220, 100)
        else pingColor = Color3.fromRGB(255, 90, 90) end
        Stats.PingLabel.Text = "Ping: " .. Stats.Ping .. " ms"
        Stats.PingLabel.TextColor3 = pingColor
    else
        Stats.PingLabel.Text = "Ping: N/A"
        Stats.PingLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end

local function SetStatsVisible(value)
    Stats.Visible = value
    if value then
        CreateStatsGui()
        Stats.Gui.Enabled = true
        if not Stats.Conn then
            Stats.Conn = RunService.RenderStepped:Connect(UpdateStats)
            table.insert(Connections, Stats.Conn)
        end
    else
        if Stats.Gui then Stats.Gui.Enabled = false end
        if Stats.Conn then
            Stats.Conn:Disconnect()
            Stats.Conn = nil
        end
    end
end

