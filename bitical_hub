local ESPColors = {
    Door        = Color3.fromRGB(120, 255, 120),
    Items       = Color3.fromRGB(0, 120, 255),
    HidingSpot  = Color3.fromRGB(255, 255, 255),
    Gold        = Color3.fromRGB(255, 220, 0),
    Entity      = Color3.fromRGB(255, 0, 0),
    Player      = Color3.fromRGB(180, 180, 180),
}

local ESPActive = {}

local function AddESP(obj, text, color)
    if not obj or not obj.Parent then return end
    if ESPActive[obj] then ESPLibrary:RemoveESP(obj) end
    ESPActive[obj] = true
    ESPLibrary:AddESP({ Object = obj, Text = text, Color = color })
end

local function ClearAllESP()
    for obj in pairs(ESPActive) do
        pcall(function() ESPLibrary:RemoveESP(obj) end)
    end
    table.clear(ESPActive)
end

-- Door ESP
