table.insert(Connections, RunService.RenderStepped:Connect(function()
    -- Main loop tick
    if Toggles.Fullbright.Value then Lighting.Ambient = Color3.fromRGB(255, 255, 255) end

    if Toggles.AntiLookman.Value and workspace:FindFirstChild("BackdoorLookman") then
        RemoteFolder.MotorReplication:FireServer(-890)
    end
    if Toggles.AntiEyes.Value and workspace:FindFirstChild("Eyes") then
        RemoteFolder.MotorReplication:FireServer(-890)
    end

    if Toggles.NoCameraShake.Value and RequiredMainGame then RequiredMainGame.csgo = CFrame.new() end
    if Toggles.NoLookBob.Value and RequiredMainGame and RequiredMainGame.spring then
        RequiredMainGame.spring.Speed = 9e9
    end

    -- AutoInteract scanning
    if Toggles.AutoInteract.Value then
        for _, prompt in ipairs(AutoInteractTable) do
            if prompt and prompt.Parent and prompt:IsA("ProximityPrompt") then
                local Base
                if prompt.Parent:IsA("BasePart") then Base = prompt.Parent
                elseif prompt.Parent:FindFirstChildWhichIsA("BasePart") then Base = prompt.Parent:FindFirstChildWhichIsA("BasePart") end
                if Base and LocalPlayer:DistanceFromCharacter(Base.Position) < prompt.MaxActivationDistance then
                    task.spawn(TriggerPrompt, prompt)
                end
            end
        end
    end

    -- Door Reach
    if Toggles.DoorReach.Value and Character then
        local rm = workspace.CurrentRooms:FindFirstChild(tostring(LatestRoom.Value))
        if rm and rm:FindFirstChild("Door") and rm.Door:FindFirstChild("ClientOpen") then
            if (Character.HumanoidRootPart.Position - rm.Door.Door.Position).Magnitude < Range then
                rm.Door.ClientOpen:FireServer()
            end
        end
    end

    -- NoAcceleration
    if Toggles.Noacceleration.Value then
        Character.HumanoidRootPart.CustomPhysicalProperties = PhysicalProperties.new(100, 0.5, 0.2)
        Character.Collision.CustomPhysicalProperties = PhysicalProperties.new(100, 0.5, 0.2)
    else
        Character.HumanoidRootPart.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.2, 0.2)
        Character.Collision.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.2, 0.2)
    end

    -- No Exit Closet Delay
    if Toggles.NoClosetExitDelay.Value and Character:GetAttribute("Hiding") == true then
        if Character.Humanoid.MoveDirection.Magnitude > 0.5 then
            RemoteFolder.CamLock:FireServer()
        end
    end

    -- Noclip
    if Toggles.Noclip.Value and Character then
        Character.Collision.CanCollide = false
        if Character.Collision:FindFirstChild("CollisionCrouch") then
            Character.Collision.CollisionCrouch.CanCollide = false
        end
        if Character:FindFirstChild("CollisionPart") then
            Character.CollisionPart.CanCollide = false
        end
        Character.HumanoidRootPart.CanCollide = false
    end

    -- Speed
    if Toggles.SpeedBoost.Value and Character and Character:FindFirstChild("Humanoid") then
        if Character:GetAttribute("Climbing") and Floor.Value == "Mines" then
            Character.Humanoid.WalkSpeed = Speed + (Options.LadderSpeedBoost.Value or 0)
        else
            Character.Humanoid.WalkSpeed = Speed
