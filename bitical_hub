-- ⭐ DOOR ESP
local DoorColor = Color3.fromRGB(0, 200, 255)
local DoorESPObjects = {}

local function AddDoorESP(door, rn)
    if not door or not door.Parent then return end
    local model = door
    if door:IsA("BasePart") and door.Parent and door.Parent:IsA("Model") then model = door.Parent end
    if door.Name == "Door" and door.Parent and door.Parent.Name == "Door" then model = door end
    if DoorESPObjects[model] then return end
    local txt = "Door " .. (door.Parent:GetAttribute("RoomID") or rn)
    Abysall.ESPLibrary:AddESP({ Object = model, Text = txt, Color = DoorColor })
    DoorESPObjects[model] = true
end
local function RemoveDoorESP(door)
    local model = door
    if door.Name == "Door" and door.Parent and door.Parent.Name == "Door" then model = door
    elseif door:IsA("BasePart") and door.Parent and door.Parent:IsA("Model") then model = door.Parent end
    Abysall.ESPLibrary:RemoveESP(model)
    DoorESPObjects[model] = nil
end
