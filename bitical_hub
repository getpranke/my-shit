-- ABYSALL-STYLE ESP LIBRARY (complete API matching Abysall.ESPLibrary)
-- ═══════════════════════════════════════════════════════════════════════════
Log("Building Abysall-style ESP library...")

local AbysallESPLibrary = (function()
    local Registry = {}
    local ColorTable = {}
    local Config = {
        Rainbow = false, ShowDistance = true,
        FillTransparency = 0.75, OutlineTransparency = 0,
        TextTransparency = 0, TextOutlineTransparency = 0,
        RenderLimit = 240, FadeTime = 0.25,
        TextSize = 20, Font = Enum.Font.Highway,
        Tracers = false, TracerSize = 0.75, TracerOrigin = "Bottom",
        Arrows = false, ArrowRadius = 250, DistanceSizeRatio = 0.8,
    }
    local RainbowHue = 0

    local function GetGui()
        local parent
        local ok = pcall(function() parent = game:GetService("CoreGui") end)
        if not ok or not parent then parent = game.Players.LocalPlayer:WaitForChild("PlayerGui") end
        local gui = parent:FindFirstChild("AbysallESPGui")
        if not gui then
            gui = Instance.new("ScreenGui")
            gui.Name = "AbysallESPGui"
            gui.ResetOnSpawn = false
            gui.IgnoreGuiInset = true
            gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            gui.Parent = parent
        end
        return gui
    end
    local ScreenGui = GetGui()

    local function GetWorldPos(obj)
        if not obj then return nil end
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Model") then
            if obj.PrimaryPart then return obj.PrimaryPart.Position end
            local ok, p = pcall(function() return obj:GetPivot() end)
            if ok then return p.Position end
        end
        return nil
    end
    local function GetDist(pos)
        local c = game.Players.LocalPlayer.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not hrp or not pos then return 0 end
        return (hrp.Position - pos).Magnitude
    end

    task.spawn(function()
        while task.wait(0.05) do
            if game:GetService("Players").LocalPlayer:GetAttribute("SapphireLoaded") == nil then break end
            RainbowHue = (RainbowHue + 0.005) % 1
            if Config.Rainbow then
                for _, d in pairs(Registry) do
                    if d.Highlight and d.Highlight.Parent then
                        local c = Color3.fromHSV(RainbowHue, 1, 1)
                        d.Highlight.FillColor = c
                        d.Highlight.OutlineColor = c
                        if d.Label then d.Label.TextColor3 = c end
                    end
                end
            end
        end
    end)

    local API = {}

    function API:AddESP(options)
        local object = options.Object
        if not object or not object.Parent then return end
        if Registry[object] then self:RemoveESP(object) end
        if not (object:IsA("BasePart") or object:IsA("Model")) then return end
        local color = options.Color or Color3.new(1,1,1)
        local text = options.Text or object.Name
        ColorTable[object] = color
        local h = Instance.new("Highlight")
        h.Name = "AbysallESPHighlight"
        h.Adornee = object
        h.FillColor = color
        h.FillTransparency = Config.FillTransparency
        h.OutlineColor = color
        h.OutlineTransparency = Config.OutlineTransparency
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = object
        local bb = Instance.new("BillboardGui")
        bb.Name = "AbysallESPLabel"
        bb.Adornee = object
        bb.AlwaysOnTop = true
        bb.Size = UDim2.fromOffset(200, 30)
        bb.StudsOffset = Vector3.new(0, 2, 0)
        bb.MaxDistance = 1000
        bb.Parent = object
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.Size = UDim2.fromScale(1, 1)
        l.Text = text
        l.TextColor3 = color
        l.TextStrokeColor3 = Color3.fromRGB(0,0,0)
        l.TextStrokeTransparency = Config.TextOutlineTransparency
        l.TextTransparency = Config.TextTransparency
        l.TextSize = Config.TextSize
        l.Font = Config.Font
        l.TextXAlignment = Enum.TextXAlignment.Center
        l.TextYAlignment = Enum.TextYAlignment.Center
        l.Parent = bb
        Registry[object] = { Highlight = h, Billboard = bb, Label = l, BaseText = text, Color = color }
    end

    function API:RemoveESP(object)
        local d = Registry[object]; if not d then return end
        if d.Highlight then d.Highlight:Destroy() end
        if d.Billboard then d.Billboard:Destroy() end
        Registry[object] = nil
        ColorTable[object] = nil
    end

    function API:UpdateObjectColor(object, color)
        local d = Registry[object]; if not d then return end
        d.Color = color; ColorTable[object] = color
        if not Config.Rainbow then
            d.Highlight.FillColor = color; d.Highlight.OutlineColor = color
            d.Label.TextColor3 = color
        end
    end

    function API:SetRainbow(v) Config.Rainbow = v end
    function API:SetShowDistance(v) Config.ShowDistance = v end
    function API:SetFillTransparency(v) Config.FillTransparency = v end
    function API:SetOutlineTransparency(v) Config.OutlineTransparency = v end
    function API:SetTextTransparency(v) Config.TextTransparency = v end
    function API:SetTextOutlineTransparency(v) Config.TextOutlineTransparency = v end
    function API:SetRenderLimit(v) Config.RenderLimit = v end
    function API:SetFadeTime(v) Config.FadeTime = v end
    function API:SetTextSize(v) Config.TextSize = v end
    function API:SetFont(f) Config.Font = f end
    function API:SetTracers(v) Config.Tracers = v end
    function API:SetTracerSize(v) Config.TracerSize = v end
    function API:SetTracerOrigin(v) Config.TracerOrigin = v end
    function API:SetArrows(v) Config.Arrows = v end
    function API:SetArrowRadius(v) Config.ArrowRadius = v end
    function API:SetDistanceSizeRatio(v) Config.DistanceSizeRatio = v end
    function API:GenerateRandomString()
        local s = ""
        for _ = 1, 8 do s = s .. string.char(math.random(65, 90)) end
        return s
    end
    function API:Unload()
        for obj in pairs(Registry) do pcall(function() API:RemoveESP(obj) end) end
        if ScreenGui then pcall(function() ScreenGui:Destroy() end) end
    end

    task.spawn(function()
        while task.wait(0.1) do
            if game:GetService("Players").LocalPlayer:GetAttribute("SapphireLoaded") == nil then break end
            for obj, d in pairs(Registry) do
                if not obj.Parent then
                    API:RemoveESP(obj)
                else
                    if d.Label then
                        if Config.ShowDistance then
                            d.Label.Text = d.BaseText .. " [" .. math.floor(GetDist(GetWorldPos(obj))) .. "m]"
                        else
                            d.Label.Text = d.BaseText
                        end
                        d.Label.TextSize = Config.TextSize
                        d.Label.Font = Config.Font
                        d.Label.TextTransparency = Config.TextTransparency
                        d.Label.TextStrokeTransparency = Config.TextOutlineTransparency
                    end
                    if d.Highlight then
                        d.Highlight.FillTransparency = Config.FillTransparency
                        d.Highlight.OutlineTransparency = Config.OutlineTransparency
                    end
                end
            end
        end
    end)

    return {
        AddESP = function(self, o) return API:AddESP(o) end,
        RemoveESP = function(self, o) return API:RemoveESP(o) end,
        UpdateObjectColor = function(self, o, c) return API:UpdateObjectColor(o, c) end,
        SetRainbow = function(self, v) return API:SetRainbow(v) end,
        SetShowDistance = function(self, v) return API:SetShowDistance(v) end,
        SetFillTransparency = function(self, v) return API:SetFillTransparency(v) end,
        SetOutlineTransparency = function(self, v) return API:SetOutlineTransparency(v) end,
        SetTextTransparency = function(self, v) return API:SetTextTransparency(v) end,
        SetTextOutlineTransparency = function(self, v) return API:SetTextOutlineTransparency(v) end,
        SetRenderLimit = function(self, v) return API:SetRenderLimit(v) end,
        SetFadeTime = function(self, v) return API:SetFadeTime(v) end,
        SetTextSize = function(self, v) return API:SetTextSize(v) end,
        SetFont = function(self, v) return API:SetFont(v) end,
        SetTracers = function(self, v) return API:SetTracers(v) end,
        SetTracerSize = function(self, v) return API:SetTracerSize(v) end,
        SetTracerOrigin = function(self, v) return API:SetTracerOrigin(v) end,
        SetArrows = function(self, v) return API:SetArrows(v) end,
        SetArrowRadius = function(self, v) return API:SetArrowRadius(v) end,
        SetDistanceSizeRatio = function(self, v) return API:SetDistanceSizeRatio(v) end,
        GenerateRandomString = function(self) return API:GenerateRandomString() end,
        Unload = function(self) return API:Unload() end,
        ColorTable = ColorTable,
    }
end)()

