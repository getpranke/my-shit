            frame.BackgroundTransparency = 0.3
            frame.Parent = oxygenNotifyUI
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 8)
            corner.Parent = frame
            local tl = Instance.new("TextLabel")
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.Text = "Oxygen: 100%"
            tl.TextColor3 = Color3.fromRGB(255, 255, 255)
            tl.TextSize = 18
            tl.Parent = frame
            oxygenNotifyUI.Enabled = false
        end
        oxygenConnection = RunService.Heartbeat:Connect(function()
            if not Toggles.OxygenNotify.Value then return end
            if Character and Character:GetAttribute("Oxygen") then
                local oxy = Character:GetAttribute("Oxygen")
                if oxy < 100 then
                    oxygenNotifyUI.Enabled = true
                    local frame = oxygenNotifyUI:FindFirstChildOfClass("Frame")
                    local tl = frame:FindFirstChildOfClass("TextLabel")
                    tl.Text = "Oxygen: " .. math.floor(oxy * 10) / 10 .. "%"
                    tl.TextColor3 = oxy < 30 and Color3.fromRGB(255, 0, 0) or oxy < 60 and Color3.fromRGB(255, 165, 0) or Color3.fromRGB(255, 255, 255)
                else
                    oxygenNotifyUI.Enabled = false
                end
            else
                oxygenNotifyUI.Enabled = false
            end
        end)
    else
        if oxygenConnection then oxygenConnection:Disconnect() oxygenConnection = nil end
        if oxygenNotifyUI then oxygenNotifyUI.Enabled = false end
    end
end)

