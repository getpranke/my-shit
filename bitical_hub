-- Fly
local Fly = {
    Enabled = false,
    Speed = 15,
    BodyVelocity = nil,
    BodyGyro = nil,
    RenderConnection = nil
}

local function SetupFly(character)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e99, 9e99, 9e99)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    Fly.BodyVelocity = bv
    
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = Camera.CFrame
    bg.Parent = root
    Fly.BodyGyro = bg
end

local function CleanupFly()
    if Fly.BodyVelocity then
        Fly.BodyVelocity:Destroy()
        Fly.BodyVelocity = nil
    end
    if Fly.BodyGyro then
        Fly.BodyGyro:Destroy()
        Fly.BodyGyro = nil
    end
end

local function OnFlyRender()
    if not Fly.Enabled then return end
    
    local character = GetCharacter()
    local root = GetRootPart()
    if not character or not root or not Fly.BodyVelocity or not Fly.BodyGyro then return end
    
    local direction = Vector3.zero
    
    if UserInputService.KeyboardEnabled then
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction = direction + Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction = direction - Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction = direction - Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction = direction + Camera.CFrame.RightVector
        end
    else
        local moveDir = GetHumanoid().MoveDirection
        if moveDir.Magnitude > 0 then
            direction = moveDir
        end
    end
    
    if direction.Magnitude > 0 then
        Fly.BodyVelocity.Velocity = direction.Unit * Fly.Speed
    else
        Fly.BodyVelocity.Velocity = Vector3.zero
    end
    
    Fly.BodyGyro.CFrame = Camera.CFrame
end

MovementBox:AddToggle("Fly", {
