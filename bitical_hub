local function shouldShowESP(roomNumber)
    local cr = LocalPlayer:GetAttribute("CurrentRoom")
    if not cr then return false end
    return roomNumber == cr or roomNumber == cr + 1
end

local DoorESPObjects = {}
local DoorColor = Color3.new(0, 1, 1)
local function AddDoorESP(door, roomNumber)
    if not door or not door.Parent then return end
    local model = door
    if door:IsA("BasePart") and door.Parent and door.Parent:IsA("Model") then model = door.Parent end
    if door.Name == "Door" and door.Parent and door.Parent.Name == "Door" then model = door end
    if DoorESPObjects[model] then DoorESPObjects[model]:Hide() end
    local displayText = "Door " .. (door.Parent:GetAttribute("RoomID") or roomNumber)
    local cr = LocalPlayer:GetAttribute("CurrentRoom")
    local isLocked, isOpen = false, not door.Anchored
    if roomNumber == cr then
        if door.Parent:FindFirstChild("Lock") then isLocked = true end
    elseif roomNumber == cr + 1 then
        local room = workspace.CurrentRooms:FindFirstChild(tostring(roomNumber))
        if room then
            for _, obj in ipairs(room:GetDescendants()) do
                if obj.Name == "KeyObtain" and not obj:GetAttribute("Used") then isLocked = true break end
            end
        end
    end
    if isOpen then displayText = "[Open] " .. displayText
    elseif isLocked then displayText = "[Locked] " .. displayText end
    local espObject = ESPLibrary:Add({
        Name = displayText, Model = model, Color = DoorColor, MaxDistance = 1000,
        TextSize = ESPGlobalSettings.TextSize, ESPType = ESPGlobalSettings.ESPType,
        FillColor = DoorColor, OutlineColor = DoorColor,
        FillTransparency = ESPGlobalSettings.FillTransparency,
        OutlineTransparency = ESPGlobalSettings.OutlineTransparency,
        Tracer = { Enabled = true, Color = DoorColor, From = "Bottom" },
        Arrow = { Enabled = true, Color = DoorColor }
    })
    DoorESPObjects[model] = espObject; espObject:Show()
end
local function RemoveDoorESP(door)
    local model = door
    if door.Name == "Door" and door.Parent and door.Parent.Name == "Door" then model = door
    elseif door:IsA("BasePart") and door.Parent and door.Parent:IsA("Model") then model = door.Parent end
    if DoorESPObjects[model] then DoorESPObjects[model]:Destroy() DoorESPObjects[model] = nil end
end
