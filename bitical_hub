-- Rooms Auto-Walk implementation (Abysall port)
local RoomsAutoWalkActive = false
local RoomsNodesFolder = Instance.new("Folder", workspace)
RoomsNodesFolder.Name = "RoomsNodes_Abysall"

table.insert(Connections, RunService.Heartbeat:Connect(function()
    if Floor.Value ~= "Rooms" or not Toggles.RoomsAutoWalk.Value or RoomsAutoWalkActive then return end
    if LatestRoom.Value >= 1000 then return end
    RoomsAutoWalkActive = true
    task.spawn(function()
        local Path = PathfindingService:CreatePath({
            AgentCanJump = true, AgentCanClimb = false, WaypointSpacing = 4,
            AgentRadius = 1.5, AgentHeight = 1.5
        })
        local Entities = { "RushMoving","AmbushMoving","BackdoorRush","A60","A120","CustomEntity","GlitchRush","GlitchAmbush" }
        local TargetPart = nil
        for _, obj in ipairs(workspace:GetChildren()) do
            if table.find(Entities, obj.Name) and obj.PrimaryPart then
                if obj.Name ~= "A60" or Toggles.RoomsAutoWalkIgnoreA60.Value then
                    -- find hiding spot
                    local Best, BestD = nil, math.huge
                    for _, h in ipairs(workspace.CurrentRooms:GetDescendants()) do
                        if h:FindFirstChild("HidePrompt") and h.PrimaryPart then
                            local d = LocalPlayer:DistanceFromCharacter(h.PrimaryPart.Position)
                            if d < BestD and h.PrimaryPart.Position.Y > -10 then
                                local HiddenPlayer = h:FindFirstChild("HiddenPlayer", true)
                                if HiddenPlayer and not HiddenPlayer.Value then
                                    BestD = d Best = h
                                end
                            end
                        end
                    end
                    if Best then TargetPart = Best end
                end
            end
        end
        if not TargetPart then
            local CR = workspace.CurrentRooms:FindFirstChild(tostring(LatestRoom.Value))
            if CR then TargetPart = CR:FindFirstChild("RoomExit") end
        end
        if not TargetPart then RoomsAutoWalkActive = false return end
        local targetPos = TargetPart.PrimaryPart and TargetPart.PrimaryPart.Position or TargetPart.Position
        if Character and Character:FindFirstChild("CollisionPart") then
            Path:ComputeAsync(Character.CollisionPart.Position, targetPos)
            for _, wp in ipairs(Path:GetWaypoints()) do
                if not Toggles.RoomsAutoWalk.Value then break end
                Character.Humanoid:MoveTo(wp.Position)
                local waittime = 0
                while waittime < 1 do
                    if (Character.HumanoidRootPart.Position - wp.Position).Magnitude < 4 then break end
                    task.wait(0.1)
                    waittime += 0.1
                end
            end
        end
        RoomsAutoWalkActive = false
    end)
end))

