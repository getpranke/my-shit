    local data = EntityNotifyMap[v.Name]
    if data and Toggles.NotifyEntitySpawn.Value then
        local selected = Options.NotifyEntitiesList.Value
        if selected and selected[data.key] then
            Notify("Entity Alert", data.msg, 4)
        end
    end

    if v.Name == "BananaPeel" or v.Name == "NannerPeel" then
        if Toggles.BypassBanana.Value then v.CanTouch = false end
    end
    if v.Name == "JeffTheKiller" and Toggles.BypassJeff.Value then
        if v.PrimaryPart and isnetworkowner and isnetworkowner(v.PrimaryPart) then
            for _, p in pairs(v:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false p.CanTouch = false end
            end
            if v:FindFirstChild("Humanoid") then v.Humanoid.Health = 0 end
        end
    end
end))

