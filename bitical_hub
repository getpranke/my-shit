-- Cleanup on unload
function Unload()
    LocalPlayer:SetAttribute("SapphireLoaded", nil)
    if renderConn then renderConn:Disconnect() end
    if InfiniteCrucifixConnection then InfiniteCrucifixConnection:Disconnect() end
    if oxygenConnection then oxygenConnection:Disconnect() end
    if hasteConn then hasteConn:Disconnect() end
    if notifyChatConn then notifyChatConn:Disconnect() end
    if oxygenNotifyUI then oxygenNotifyUI:Destroy() end
    if hasteUI then hasteUI:Destroy() end
    for _, c in ipairs(Connections) do
        if type(c) == "table" and c.Disconnect then c:Disconnect()
        elseif typeof(c) == "RBXScriptConnection" then c:Disconnect() end
    end
    for _, obj in pairs(DoorESPObjects) do pcall(function() obj:Destroy() end) end
    for _, obj in pairs(ObjectiveESPObjects) do pcall(function() obj:Destroy() end) end
    for _, obj in pairs(HidingSpotESPObjects) do pcall(function() obj:Destroy() end) end
    for _, obj in pairs(ChestESPObjects) do pcall(function() obj:Destroy() end) end
    for _, obj in pairs(PlayerESPObjects) do pcall(function() obj:Destroy() end) end
    for _, obj in pairs(ItemsESPObjects) do pcall(function() obj:Destroy() end) end
    for _, obj in pairs(CurrencyESPObjects) do pcall(function() obj:Destroy() end) end
    for _, obj in pairs(LadderESPObjects) do pcall(function() obj:Destroy() end) end
    for _, obj in pairs(EntityESPObjects) do pcall(function() obj:Destroy() end) end

    if Character and Character:FindFirstChild("Humanoid") then
        Character.Humanoid.WalkSpeed = 16
        Character.Humanoid.JumpPower = 50
        Character.Humanoid.HipHeight = 2.367
    end
    if Character then
        if Character:FindFirstChild("_CollisionPart") then Character._CollisionPart:Destroy() end
        if Character:FindFirstChild("_CollisionPart2") then Character._CollisionPart2:Destroy() end
    end
    if RemoteFolder:FindFirstChild("Crouch") then
        RemoteFolder.Crouch:FireServer(false)
    end
    SeekNodesFolder:Destroy()
    RoomsNodesFolder:Destroy()
    pcall(function() RunService:UnbindFromRenderStep("THIRD_PERSON_SYS") end)
    pcall(function() RunService:UnbindFromRenderStep("FOV_SYS") end)
    pcall(function() RunService:UnbindFromRenderStep("GOD_MODE_CAMERA_SYS") end)
    Library:Unload()
end

