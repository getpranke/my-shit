-- MAIN LOOP
-- ═══════════════════════════════════════════════════════════════

local AutoInteractTimer = 0
local AutoLibraryTimer = 0
local AutoAnchorTimer = 0
local DoorReachTimer = 0
local InfItemsTimer = 0
local PlayerESPTimer = 0

local InfParams = RaycastParams.new()
InfParams.FilterType = Enum.RaycastFilterType.Exclude

table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    AutoInteractTimer += dt
    AutoLibraryTimer += dt
    AutoAnchorTimer += dt
    DoorReachTimer += dt
    InfItemsTimer += dt
    PlayerESPTimer += dt
    
    -- Update alive state
    local alive = LocalPlayer:GetAttribute("Alive")
    if not alive then
        if Toggles.InfRevive.Value and Floor.Value == "Fools" or Floor.Value == "OldHotel" then
            RemotesFolder.Revive:FireServer()
        end
        return
    end
    
    -- Update camera reference
    if Camera ~= workspace.CurrentCamera then
        Camera = workspace.CurrentCamera
    end
    
    -- Speed
    if Toggles.SpeedBoost.Value and GetHumanoid() then
        if not GetCharacter():GetAttribute("Climbing") then
            GetHumanoid().WalkSpeed = Speed
        elseif Floor.Value == "Mines" then
            GetHumanoid().WalkSpeed = Speed + Options.LadderSpeedBoost.Value
        end
    end
    
    -- Jump Power
    if Toggles.EnableJump.Value and GetHumanoid() then
        if GetHumanoid().UseJumpPower then
            GetHumanoid().JumpPower = jumpPowerValue
        else
            GetHumanoid().JumpHeight = jumpPowerValue
        end
    end
    
    -- Third Person
    if Toggles.ThirdPerson.Value then
        Camera.CFrame = Camera.CFrame * CFrame.new(Options.TP_X.Value, Options.TP_Y.Value, Options.TP_Z.Value)
    end
    
    -- FOV
    Camera.FieldOfView = Options.FOV.Value
    
    -- No Camera Shake
    if Toggles.NoCameraShake.Value then
        local mainGame = LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game
        if mainGame then
            local success, required = pcall(require, mainGame)
            if success and required then
                required.csgo = CFrame.new()
            end
        end
    end
    
    -- Godmode
    if Toggles.Godmode.Value and GetCharacter() then
        local char = GetCharacter()
        if RemotesFolder.Name == "RemotesFolder" then
            if char:FindFirstChild("LowerTorso") and char.LowerTorso:FindFirstChild("Root") then
                char.LowerTorso.Root.C1 = CFrame.new(0, -2.3, 0)
            end
            GetHumanoid().HipHeight = 0.22
            char.Collision.Size = Vector3.new(1, 1, 4)
            if char.Collision:FindFirstChild("CollisionCrouch") then
                char.Collision.CollisionCrouch.Size = Vector3.new(1, 1, 4)
            end
        end
    end
    
    -- Noclip
    if Toggles.Noclip.Value and GetCharacter() then
        for _, v in pairs(GetCharacter():GetChildren()) do
            if v:IsA("BasePart") and v.Name ~= "CollisionClone" then
                v.CanCollide = false
            end
        end
        if GetCharacter():FindFirstChild("Collision") then
            GetCharacter().Collision.CanCollide = false
            if GetCharacter().Collision:FindFirstChild("CollisionCrouch") then
                GetCharacter().Collision.CollisionCrouch.CanCollide = false
            end
        end
    end
    
    -- Auto Interact
    if Toggles.AutoInteract.Value and AutoInteractTimer > Options.AutoInteractDelay.Value then
        AutoInteractTimer = 0
        local root = GetRootPart()
        if root then
            for i = #Interactions, 1, -1 do
                local prompt = Interactions[i]
                if not prompt or not prompt.Parent then
                    table.remove(Interactions, i)
                else
                    local targetPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                    if targetPart and GetDistanceToPlayer(targetPart.Position) <= prompt.MaxActivationDistance then
                        -- Check ignore list
                        if prompt.Parent.Name == "GoldPile" and Options.IgnoreList.Value["Coins"] then
                            continue
                        end
                        if prompt.Parent.Name == "GlitchCube" and Options.IgnoreList.Value["Glitch Cube"] then
                            continue
                        end
                        if prompt.Parent:GetAttribute("JeffShop") and Options.IgnoreList.Value["Jeff Items"] then
                            continue
                        end
                        
                        pcall(fireproximityprompt, prompt)
                    end
                end
            end
        end
    end
    
    -- Auto Library Code
    if Toggles.AutoLibraryCode.Value and AutoLibraryTimer > 0.5 and LatestRoom.Value == 50 then
        AutoLibraryTimer = 0
        local Code = GetLibraryCode()
        if Code then
            if Toggles.BruteForceLibCode.Value and string.find(Code, "_") then
                local Bruted = ""
                for i = 1, #Code do
                    local char = string.sub(Code, i, i)
                    Bruted = Bruted .. (char == "_" and tostring(math.random(0, 9)) or char)
                end
                Code = Bruted
            end
            RemotesFolder.PL:FireServer(Code)
        end
    end
    
    -- Notify Library Code
    if Toggles.NotifyLibraryCode.Value and AutoLibraryTimer > 5 and LatestRoom.Value == 50 then
        AutoLibraryTimer = 0
        local Code = GetLibraryCode()
        if Code then
            Notify("Padlock Code: " .. Code, 5)
        end
    end
    
    -- Door Reach
    if Toggles.DoorReach.Value and DoorReachTimer > 0.2 then
        DoorReachTimer = 0
        local Rooms = workspace:FindFirstChild("CurrentRooms")
        local Room = Rooms and Rooms:FindFirstChild(tostring(LatestRoom.Value))
        local Door = Room and Room:FindFirstChild("Door")
        if Door and Door:FindFirstChild("Door") and GetDistanceToPlayer(Door.Door.Position) < DoorReachRange then
            Door.ClientOpen:FireServer()
        end
    end
    
    -- Anti Eyes
    if Toggles.AntiEyes.Value then
        if workspace:FindFirstChild("Eyes") and not GetCharacter():GetAttribute("Hiding") then
            if RemotesFolder.Name == "RemotesFolder" then
                RemotesFolder.MotorReplication:FireServer(-650)
            else
                RemotesFolder.MotorReplication:FireServer(0, -650, 0, false)
            end
        end
    end
    
    -- Fullbright
    if Toggles.Fullbright.Value then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
    end
    
    -- No Fog
    if Toggles.NoFog.Value then
        Lighting.FogEnd = 100000
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") and v.Density > 0 then
                v.Density = 0
            end
        end
    end
    
    -- Infinite Items
    if Toggles.InfiniteItems.Value and InfItemsTimer > 0.15 then
        InfItemsTimer = 0
        local char = GetCharacter()
        local tool = char and (char:FindFirstChild("Lockpick") or char:FindFirstChild("SkeletonKey") or char:FindFirstChild("Shears"))
        if tool then
            for _, prompt in pairs(StoredPrompts) do
                if prompt and prompt.Parent and GetDistanceToPlayer(prompt.Parent.Position) < (prompt.MaxActivationDistance + 5) then
                    -- Simplified infinite items logic
                    pcall(fireproximityprompt, prompt)
                end
            end
        end
    end
    
    -- Infinite Crucifix
    if Toggles.InfiniteCrucifix.Value and not Toggles.Godmode.Value then
        local char = GetCharacter()
        local tool = char and char:FindFirstChild("Crucifix")
        if tool then
            local root = GetRootPart()
            for _, Entity in pairs(workspace:GetChildren()) do
                local MaxRange = InfCrucifixTable[Entity.Name]
                if MaxRange and Entity.PrimaryPart then
                    local dist = GetDistanceToPlayer(Entity.PrimaryPart.Position)
                    if dist < (MaxRange + 40) then
                        InfParams.FilterDescendantsInstances = {char, Entity}
                        local Hit = workspace:Raycast(root.Position, Entity.PrimaryPart.Position - root.Position, InfParams)
                        if not Hit then
                            task.spawn(function()
                                RemotesFolder.DropItem:FireServer(tool)
                                local StartTime = tick()
                                repeat
                                    task.wait(0.01)
                                    local Drops = workspace:FindFirstChild("Drops")
                                    local Drop = Drops and Drops:FindFirstChild("Crucifix")
                                    local Prompt = Drop and Drop:FindFirstChildOfClass("ProximityPrompt")
                                    if Prompt then
                                        pcall(fireproximityprompt, Prompt)
                                    end
                                until char:FindFirstChild("Crucifix") or (tick() - StartTime) > 1.2
                            end)
                            break
                        end
                    end
                end
            end
        end
    end
    
    -- Player ESP
    if Toggles.ESP_Player.Value and PlayerESPTimer > 1 then
        PlayerESPTimer = 0
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character then
                local hum = v.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    AddESP(v.Character, v.Name .. " [" .. math.floor((hum.Health / hum.MaxHealth) * 100) .. "%]", Colors.Player)
                end
            end
        end
    end
end))

