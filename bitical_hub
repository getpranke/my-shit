local function isOwned(item)
    local cur = item
    while cur and cur ~= workspace do
        if cur:IsA("Model") then
            local p = Players:GetPlayerFromCharacter(cur)
            if p and p == LocalPlayer then return true end
            if cur:IsA("Tool") then
                local o = cur:FindFirstChild("Owner")
                if o and o.Value then return true end
                local par = cur.Parent
                if par and (par:IsA("Backpack") or (par:IsA("Model") and Players:GetPlayerFromCharacter(par))) then
                    return true
                end
            end
        end
        cur = cur.Parent
    end
    return false
end
