Tabs.Visuals:AddSection("ESP")

local ESPColors = {
    Door        = Color3.fromRGB(120, 255, 120),
    Items       = Color3.fromRGB(0, 120, 255),
    HidingSpot  = Color3.fromRGB(255, 255, 255),
    Gold        = Color3.fromRGB(255, 220, 0),
    Entity      = Color3.fromRGB(255, 0, 0),
    Player      = Color3.fromRGB(180, 180, 180),
}

local ESPActive = {}

local function AddESP(obj, text, color)
    if not obj or not obj.Parent then return end
    if ESPActive[obj] then ESPLibrary:RemoveESP(obj) end
    ESPActive[obj] = true
    ESPLibrary:AddESP({ Object = obj, Text = text, Color = color })
end

local function RemoveESP(obj)
    if ESPActive[obj] then
        ESPActive[obj] = nil
        ESPLibrary:RemoveESP(obj)
    end
end

local function ClearAllESP()
    for obj in pairs(ESPActive) do
        pcall(function() ESPLibrary:RemoveESP(obj) end)
    end
    table.clear(ESPActive)
end

local function CreateESPToggle(id, title, defaultColor, onEnable)
    local toggle = Tabs.Visuals:AddToggle(id, { Title = title, Default = false })
    local picker = Tabs.Visuals:AddColorpicker(id .. "Color", {
        Title = title .. " Color",
        Default = defaultColor,
    })
    toggle:OnChanged(function(Value)
        if Value then onEnable() else ClearAllESP() end
    end)
    picker:OnChanged(function(Value)
        if Options[id].Value then
            Options[id]:SetValue(false)
            Options[id]:SetValue(true)
        end
    end)
    return toggle, picker
end

CreateESPToggle("ESP_Door", "Door ESP", ESPColors.Door, function()
    for _, v in pairs(CurrentRooms:GetDescendants()) do
        if v.Name == "Door" and v.Parent and v.Parent.Name == "Door" then
            AddESP(v, "Door", Options.ESP_DoorColor.Value)
