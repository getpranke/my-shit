local function OnCharacterAdded(character)
    task.wait(1)
    
    if character then
        MainGame = LocalPlayer.PlayerGui.MainUI.Initiator:WaitForChild("Main_Game")
        RemoteListener = MainGame:WaitForChild("RemoteListener")
        InfParams.FilterDescendantsInstances = {character}
        
        if Toggles.NoCutscenes.Value then
            local Cutscenes = RemoteListener:FindFirstChild("Cutscenes") or RemoteListener:FindFirstChild("Cutscenes_")
            if Cutscenes then
                Cutscenes.Name = "Cutscenes_"
            end
        end
    end
end

table.insert(Connections, LocalPlayer.CharacterAdded:Connect(OnCharacterAdded))

