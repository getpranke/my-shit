-- Mines background: auto anchor / minecart / seek path
do
    local autoAnchorRunning = false
    local autoAnchorConnection = nil
    local lastCheck = 0
    local cachedAnchors = {}
    local function updateAnchorCache()
        cachedAnchors = {}
        local room50 = workspace.CurrentRooms:FindFirstChild("50")
        if not room50 then
            for roomName, room in pairs(workspace.CurrentRooms:GetChildren()) do
                if tonumber(roomName) and tonumber(roomName) >= 50 then room50 = room break end
            end
        end
        if room50 then
            for _, anchor in ipairs(room50:GetDescendants()) do
                if anchor.Name == "MinesAnchor" then table.insert(cachedAnchors, anchor) end
            end
        end
    end
    local function solveAnchor()
        if not autoAnchorRunning then return end
        local mainUI = LocalPlayer.PlayerGui:FindFirstChild("MainUI")
        local AnchorHintFrame = mainUI and mainUI:FindFirstChild("AnchorHintFrame")
        if not AnchorHintFrame then return end
        local anchorSignText = AnchorHintFrame:FindFirstChild("AnchorCode")
        local currentCode = AnchorHintFrame:FindFirstChild("Code")
        if not anchorSignText or not currentCode then return end
        local signText = anchorSignText.Text
        local codeText = currentCode.Text
        if signText == "" or codeText == "" then return end
        local pp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position
        if not pp then return end
        for _, anchor in ipairs(cachedAnchors) do
            if not autoAnchorRunning then break end
            local sign = anchor:FindFirstChild("Sign")
            if sign then
                local textLabel = sign:FindFirstChild("TextLabel")
                if textLabel and textLabel.Text == signText then
                    local ap = anchor.PrimaryPart and anchor.PrimaryPart.Position
                    if ap then
                        if (pp - ap).Magnitude < 12 then
                            local anchorRemote = anchor:FindFirstChild("AnchorRemote")
                            if anchorRemote then pcall(function() anchorRemote:InvokeServer(codeText) end) end
                            break
                        end
                    end
                end
            end
        end
    end
    Toggles.AutoAnchorSolver:OnChanged(function(Value)
        if Value then
            autoAnchorRunning = true
            updateAnchorCache()
            autoAnchorConnection = RunService.Heartbeat:Connect(function()
                if not autoAnchorRunning then return end
                local now = tick()
                if now - lastCheck >= 0.5 then lastCheck = now solveAnchor() end
            end)
        else
            autoAnchorRunning = false
            if autoAnchorConnection then autoAnchorConnection:Disconnect() autoAnchorConnection = nil end
        end
    end)

    -- Minecart auto steer
    local Minecart = { NearestTurnNode = nil, Ducked = false, LastDuck = 0 }
    local function GetMinecart() local cam = workspace.CurrentCamera return cam and cam:FindFirstChild("MinecartRig") ~= nil end
    local function GetNearestTurnNode()
        local nearest, dist = nil, math.huge
        local pp = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position
        if not pp then return nil end
        for _, node in ipairs(workspace:GetDescendants()) do
            if node.Name == "MinecartNode" and node:IsA("BasePart") and node:GetAttribute("Turn") then
                local d = (pp - node.Position).Magnitude
                if d < Options.AutoSteerMinecartTurnDistance.Value and d < dist then dist = d nearest = node end
            end
        end
        return nearest
    end
    local function GetNearestDuckBoard()
        local nearest, dist = nil, math.huge
        local pp = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position
        if not pp then return nil end
        for _, board in ipairs(workspace:GetDescendants()) do
            if board.Name == "DuckBoard" and board:IsA("BasePart") then
                local d = (pp - board.Position).Magnitude
                if d < Options.AutoSteerMinecartDuckDistance.Value and d < dist then dist = d nearest = board end
            end
        end
        return nearest
    end
    task.spawn(function()
        while task.wait() do
            if Library.Unloaded then break end
            if not (Toggles.AutoSteerMinecart and Toggles.AutoSteerMinecart.Value) or not GetMinecart() then
                Minecart.Ducked = false
                continue
            end
            if tick() - Minecart.LastDuck < 0.1 then continue end
            Minecart.NearestTurnNode = GetNearestTurnNode()
            if not Minecart.Ducked and GetNearestDuckBoard() then
                if RequiredMainGame and RequiredMainGame.crouch then RequiredMainGame.crouch(true) end
                Minecart.Ducked = true
            elseif not GetNearestDuckBoard() and Minecart.Ducked then
                if RequiredMainGame and RequiredMainGame.crouch then RequiredMainGame.crouch(false) end
                Minecart.Ducked = false
            end
            Minecart.LastDuck = tick()
        end
    end)
