table.insert(Connections, workspace.DescendantAdded:Connect(function(v)
    task.wait(0.05)
    if not v.Parent then return end

    if v:IsA("ProximityPrompt") then
        if Options.InstantPrompt.Value then
            if not v:GetAttribute("OldHold") then v:SetAttribute("OldHold", v.HoldDuration) end
            v.HoldDuration = 0
        end
        if Options.PromptReach.Value then
            if not v:GetAttribute("Dist") then v:SetAttribute("Dist", v.MaxActivationDistance) end
            v.MaxActivationDistance = v:GetAttribute("Dist") * PromptReach
        end
        if Options.PromptClip.Value then
            if not v:GetAttribute("OldLOS") then v:SetAttribute("OldLOS", v.RequiresLineOfSight) end
            v.RequiresLineOfSight = false
        end
        if Options.AutoInteract.Value and not AutoInteractIgnore[v.Name] then
            table.insert(InteractPrompts, v)
        end
    end

    if Options.AntiLag.Value and v:IsA("BasePart") then
        if not v:GetAttribute("Mat") then v:SetAttribute("Mat", v.Material) end
        v.Material = Enum.Material.Plastic
    end

    if v.Name == "GiggleCeiling" and Options.BypassGiggle.Value then
        repeat task.wait() until v:FindFirstChild("Hitbox") or not v.Parent
        local hb = v:FindFirstChild("Hitbox")
        if hb then hb.CanTouch = false end
    end

    if v.Name == "Snare" and Options.BypassSnare.Value then
        repeat task.wait() until v:FindFirstChild("Hitbox") or not v.Parent
        local hb = v:FindFirstChild("Hitbox")
        if hb then hb.CanTouch = false end
    end

    if (v.Name == "DoorFake" or v.Name == "FakeDoor") and Options.BypassDupe.Value then
        local h = v:WaitForChild("Hidden", 5)
        if h then h.CanTouch = false end
    end

    if v.Name == "Lava" and Options.BypassKillbricks.Value then v.CanTouch = false end

    if v.Name == "ScaryWall" and Options.BypassSeekingWall.Value then
        for _, p in pairs(v:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = false p.CanCollide = false end
        end
    end

    if v.Name == "GloomPile" or v.Name == "GloomEgg" then
        if Options.BypassGloombatEggs.Value then
            for _, p in pairs(v:GetDescendants()) do
                if p:IsA("BasePart") then p.CanTouch = false end
            end
        end
    end

    if v.Name == "SideroomSpace" and Options.BypassVacuum.Value then
        local col = v:WaitForChild("Collision", 3)
        if col then col.CanCollide = true col.CanTouch = false end
    end

    if v.Name == "ElevatorBreaker" and Options.AutoBreaker.Value then
        task.spawn(function()
            local gui = v:WaitForChild("SurfaceGui")
            local label = gui:WaitForChild("Frame"):WaitForChild("Code")
            local function solve()
                task.wait(0.05)
                if not Options.AutoBreaker.Value then return end
                local target = tonumber(label.Text)
                if not target then return end
                for _, sw in pairs(v:GetChildren()) do
                    if sw.Name == "BreakerSwitch" and sw:GetAttribute("ID") == target then
                        local trans = label:WaitForChild("Frame").BackgroundTransparency
                        local pc = sw:FindFirstChild("PrismaticConstraint")
                        local light = sw:FindFirstChild("Light")
                        local sound = sw:FindFirstChild("Sound")
                        if trans == 0 then
                            sw:SetAttribute("Enabled", true)
                            if pc then pc.TargetPosition = -0.2 end
                            if light then light.Material = Enum.Material.Neon end
                            if sound then sound:Play() end
                        elseif trans == 1 then
                            sw:SetAttribute("Enabled", false)
                            if pc then pc.TargetPosition = 0.2 end
                            if light then light.Material = Enum.Material.Glass end
                            if sound then sound:Play() end
                        end
                        break
                    end
                end
            end
            label:GetPropertyChangedSignal("Text"):Connect(solve)
            solve()
        end)
    end
end))

