        DoubleClick = true,
        Func = function()
            if LatestRoom.Value < 100 then
                Notify("Error", "Must be in Room 200", 4)
                return
            end
            local isCutscene = false
            local conn = RemotesFolder.Cutscene.OnClientEvent:Connect(function()
                isCutscene = true
                task.wait(7)
                isCutscene = false
            end)
            local function GetNextPump()
                local highest, obj = -69420, nil
                for _, v in pairs(CurrentRooms:GetDescendants()) do
                    if v.Name == "WaterPump" and not v:GetAttribute("Bitical_Completed") then
                        if v.PrimaryPart and v.PrimaryPart.Position.Y > highest then
                            highest = v.PrimaryPart.Position.Y
                            obj = v
                        end
                    end
                end
                return obj
            end
            Notify("Auto Dam Seek", "Starting...", 4)
            while task.wait(0.1) do
                local p = GetNextPump()
                if not p then break end
                while task.wait(0.1) do
                    if isCutscene then continue end
                    GetCharacter():PivotTo(p:GetPivot())
