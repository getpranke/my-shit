Log("Installing unified hook...")
do
    if hookmetamethod and newcclosure and getnamecallmethod then
        local ok, err = pcall(function()
            local original
            original = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local method = getnamecallmethod()
                local isI = (typeof(self) == "Instance")
                if method == "FireServer" and isI then
                    if self.Name == "ClutchHeartbeat" and Toggles.AutoHeartbeatMiniGame and Toggles.AutoHeartbeatMiniGame.Value then
                        local args = {...}; args[1] = true
                        return original(self, unpack(args))
                    end
                    if self.Name == "Crouch" and (cogAlt or slideSH) then
                        local args = {...}
                        if cogAlt then args[1] = true end
                        if slideSH then args[2] = true end
                        return original(self, unpack(args))
                    end
                end
                if method == "Fire" and isI and self.Name == "FireToolProjectile" and (noSpread or fastThrow) then
                    local args = {...}
                    if noSpread then
                        args[3] = workspace.CurrentCamera.CFrame.Position
                        args[4] = workspace.CurrentCamera.CFrame.LookVector
                    end
                    if fastThrow then args[5] = 500 end
                    return original(self, unpack(args))
                end
                return original(self, ...)
            end))
            hookNamecall = original
        end)
        if not ok then LogErr("Hook failed: " .. tostring(err)); hookNamecall = nil
        else LogOk("Hook installed") end
    else LogWarn("No hookmetamethod") end
end

