do
    task.spawn(function()
        while task.wait(0.1) do
            if Library.Unloaded then break end
            if not (Toggles.AutoCloset and Toggles.AutoCloset.Value) then continue end
            local char = LocalPlayer.Character; if not char then continue end
            if tick() - (getgenv().SniperLastAutoHide or 0) < 0.1 then continue end
            getgenv().SniperLastAutoHide = tick()

            local nearestEntity, nearestDist = nil, math.huge
            local entityDistances = {
                RushMoving = 85, AmbushMoving = 150, A60 = 125, A120 = 85,
                GlitchRush = 90, GlitchAmbush = 175, BackdoorRush = 85, CustomEntity = 85,
            }
            for _, ent in ipairs(workspace:GetChildren()) do
                if entityDistances[ent.Name] and ent.PrimaryPart and ent:GetAttribute("Inactive") ~= true then
                    local aliasMap = {
                        RushMoving = "Rush", AmbushMoving = "Ambush", A60 = "A-60",
                        A120 = "A-120", BackdoorRush = "Blitz", GlitchRush = "RNIUSHCG==",
                        GlitchAmbush = "AR0xMBUSH",
                    }
                    local alias = aliasMap[ent.Name] or ent.Name
                    if Options.AutoClosetEntityList.Value[alias] then
                        local d = (char:GetPivot().Position - ent.PrimaryPart.Position).Magnitude
                        if d < entityDistances[ent.Name] and d < nearestDist then
                            nearestDist = d; nearestEntity = ent
                        end
                    end
                end
            end

            if nearestEntity then
                local closest, closestDist = nil, math.huge
                for _, object in ipairs(workspace:GetDescendants()) do
                    if object:FindFirstChild("HidePrompt") and object.PrimaryPart then
                        local d = (char:GetPivot().Position - object.PrimaryPart.Position).Magnitude
                        if d < closestDist then closestDist = d; closest = object end
                    end
                end
                if closest and char:GetAttribute("Hiding") ~= true then
                    local hp = closest:FindFirstChild("HidePrompt")
                    if hp and fireproximityprompt then fireproximityprompt(hp) end
                end
                if Toggles.SpectateEntity.Value and char:GetAttribute("Hiding") and nearestEntity.PrimaryPart then
                    local cam = workspace.CurrentCamera
                    local head = char:FindFirstChild("Head")
                    if head then
                        if Options.SpectateEntityMode.Value == "Player to Entity" then
                            cam.CFrame = CFrame.lookAt(head.Position, nearestEntity.PrimaryPart.Position)
                        else
                            cam.CFrame = CFrame.lookAt(nearestEntity.PrimaryPart.Position, head.Position)
                        end
                    end
                end
            elseif char:GetAttribute("Hiding") == true then
                if RemoteFolder:FindFirstChild("CamLock") then RemoteFolder.CamLock:FireServer() end
            end
        end
    end)
end

