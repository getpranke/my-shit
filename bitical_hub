    A60 = "A-60", A120 = "A-120", GlitchRush = "RNIUSHCG==", GlitchAmbush = "AR0xMBUSH",
}
local AutoClosetDistances = { RushMoving = 85, AmbushMoving = 150, A60 = 125, A120 = 85, GlitchRush = 90, GlitchAmbush = 175, BackdoorRush = 85 }

table.insert(Connections, RunService.Heartbeat:Connect(function()
    if not Toggles.AutoClosetToggle.Value then SpectateEntity = nil return end
    if not Character then return end
    local Nearest, NearestD = nil, math.huge
    for _, e in ipairs(workspace:GetChildren()) do
        local dist = AutoClosetDistances[e.Name]
        if dist and e.PrimaryPart and e:GetAttribute("Inactive") ~= true then
            local alias = AutoClosetIgnoreMap[e.Name]
            if not Options.AutoClosetIgnoreList.Value[alias] then
                local d = LocalPlayer:DistanceFromCharacter(e.PrimaryPart.Position)
                if d < dist and d < NearestD then Nearest, NearestD = e, d end
            end
        end
    end
    if Nearest then
        local Closest, ClosestD = nil, math.huge
        for _, h in ipairs(workspace.CurrentRooms:GetDescendants()) do
            if h:FindFirstChild("HidePrompt") and h.PrimaryPart then
                local d = LocalPlayer:DistanceFromCharacter(h.PrimaryPart.Position)
                if d < h.HidePrompt.MaxActivationDistance and d < ClosestD then
                    Closest, ClosestD = h, d
                end
            end
        end
        if Character:GetAttribute("Hiding") ~= true and Closest then
            pcall(fireproximityprompt, Closest.HidePrompt)
        end
        if Character:GetAttribute("Hiding") and Toggles.SpectateEntityToggle.Value then
            SpectateEntity = Nearest
        end
    elseif Character:GetAttribute("Hiding") == true then
        SpectateEntity = nil
        if RemoteFolder and RemoteFolder:FindFirstChild("CamLock") then
            RemoteFolder.CamLock:FireServer()
        end
    else
        SpectateEntity = nil
    end
end))

