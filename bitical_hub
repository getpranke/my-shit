do
    local autoAnchorRunning = false
    local autoAnchorConnection = nil
    local lastCheck = 0
    local cachedAnchors = {}
    local function updateAnchorCache()
        cachedAnchors = {}
        local r50 = workspace.CurrentRooms:FindFirstChild("50")
        if not r50 then
            for rn, r in pairs(workspace.CurrentRooms:GetChildren()) do
                if tonumber(rn) and tonumber(rn) >= 50 then r50 = r break end
            end
        end
        if r50 then
            for _, a in ipairs(r50:GetDescendants()) do
                if a.Name == "MinesAnchor" then table.insert(cachedAnchors, a) end
            end
        end
    end
    local function solveAnchor()
        if not autoAnchorRunning then return end
        local mainUI = LocalPlayer.PlayerGui:FindFirstChild("MainUI")
        local AHF = mainUI and mainUI:FindFirstChild("AnchorHintFrame")
        if not AHF then return end
        local asT = AHF:FindFirstChild("AnchorCode"); local cc = AHF:FindFirstChild("Code")
        if not asT or not cc then return end
        local st = asT.Text; local ct = cc.Text
        if st == "" or ct == "" then return end
        local pp = Character and Character:FindFirstChild("HumanoidRootPart") and Character.HumanoidRootPart.Position
        if not pp then return end
        for _, a in ipairs(cachedAnchors) do
            if not autoAnchorRunning then break end
            local sign = a:FindFirstChild("Sign")
            if sign then
                local tl = sign:FindFirstChild("TextLabel")
                if tl and tl.Text == st then
                    local ap = a.PrimaryPart and a.PrimaryPart.Position
                    if ap and (pp - ap).Magnitude < 12 then
                        local ar = a:FindFirstChild("AnchorRemote")
                        if ar then pcall(function() ar:InvokeServer(ct) end) end
                        break
                    end
                end
            end
        end
    end
    Toggles.AutoAnchorSolver:OnChanged(function(v)
        if v then
            autoAnchorRunning = true
            updateAnchorCache()
            autoAnchorConnection = RunService.Heartbeat:Connect(function()
                if not autoAnchorRunning then return end
                if tick() - lastCheck >= 0.5 then lastCheck = tick(); solveAnchor() end
            end)
        else
            autoAnchorRunning = false
            if autoAnchorConnection then autoAnchorConnection:Disconnect(); autoAnchorConnection = nil end
        end
    end)

    local Minecart = { NearestTurnNode=nil, Ducked=false, LastDuck=0 }
    local function GetMinecart() local cam = workspace.CurrentCamera return cam and cam:FindFirstChild("MinecartRig") ~= nil end
    local function GetNearestTurnNode()
        local nearest, dist = nil, math.huge
        local pp = Character and Character:GetPivot().Position
        if not pp then return nil end
        for _, node in ipairs(workspace:GetDescendants()) do
            if node.Name == "MinecartNode" and node:IsA("BasePart") and node:GetAttribute("Turn") then
                local d = (pp - node.Position).Magnitude
                if d < Options.AutoSteerMinecartTurnDistance.Value and d < dist then dist = d; nearest = node end
            end
        end
        return nearest
    end
    local function GetNearestDuckBoard()
        local nearest, dist = nil, math.huge
        local pp = Character and Character:GetPivot().Position
        if not pp then return nil end
        for _, b in ipairs(workspace:GetDescendants()) do
            if b.Name == "DuckBoard" and b:IsA("BasePart") then
                local d = (pp - b.Position).Magnitude
                if d < Options.AutoSteerMinecartDuckDistance.Value and d < dist then dist = d; nearest = b end
            end
        end
        return nearest
    end
    task.spawn(function()
        while task.wait() do
            if Library.Unloaded then break end
            if not Toggles.AutoSteerMinecart.Value or not GetMinecart() then Minecart.Ducked = false; continue end
            if tick() - Minecart.LastDuck < 0.1 then continue end
            Minecart.NearestTurnNode = GetNearestTurnNode()
            if not Minecart.Ducked and GetNearestDuckBoard() then
                if RequiredMainGame and RequiredMainGame.crouch then RequiredMainGame.crouch(true) end
                Minecart.Ducked = true
            elseif not GetNearestDuckBoard() and Minecart.Ducked then
                if RequiredMainGame and RequiredMainGame.crouch then RequiredMainGame.crouch(false) end
                Minecart.Ducked = false
            end
            Minecart.LastDuck = tick()
        end
    end)
    pcall(function()
        local Controls = require(LocalPlayer.PlayerScripts.PlayerModule):GetControls()
        local Original = Controls.GetMoveVector
        Controls.GetMoveVector = function(...)
            if Toggles.AutoSteerMinecart.Value and Floor.Value == "Mines" and GetMinecart() then
                local node = Minecart.NearestTurnNode
                if node then
                    local t = node:GetAttribute("Turn")
                    if t == "Left" then return Vector3.new(-1,0,0) end
                    if t == "Right" then return Vector3.new(1,0,0) end
                    return Vector3.zero
                end
            end
            return Original(...)
        end
    end)

    Toggles.AnticheatBypass:OnChanged(function(v)
        if not v then RemoteFolder.ClimbLadder:FireServer() end
        if v then Library:Notify("Climb a ladder to bypass", 9) end
    end)
    Character:GetAttributeChangedSignal("Climbing"):Connect(function()
        if Character:GetAttribute("Climbing") == true and Toggles.AnticheatBypass.Value then
            task.wait(0.4); Character:SetAttribute("Climbing", false)
            Library:Notify("Bypass successful", 7)
        end
    end)
    Toggles.AntiSeekFlood:OnChanged(function(v)
        local r = ReplicatedStorage.RemotesFolder:FindFirstChild("SeekSlop")
        if r then r.Name = v and "_SeekSlop" or "SeekSlop" end
    end)
end

