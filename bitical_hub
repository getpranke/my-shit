local function scanPrompts(validParents, validNames)
    local t = {}
    for _, v in ipairs(workspace.CurrentRooms:GetDescendants()) do
        if v:IsA("ProximityPrompt") and (validParents[v.Parent.Name] or validNames[v.Name]) then table.insert(t, v) end
