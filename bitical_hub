-- MAIN LOOP
-- ═══════════════════════════════════════════════════════════════

local timers = { AI = 0, Lib = 0, Door = 0, Notify = 0, Oxy = 0 }

local InfParams = RaycastParams.new()
InfParams.FilterType = Enum.RaycastFilterType.Exclude

table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    timers.AI += dt timers.Lib += dt timers.Door += dt timers.Notify += dt timers.Oxy += dt

    if not LocalPlayer:GetAttribute("Alive") then
        if Toggles.InfiniteRevives and Toggles.InfiniteRevives.Value then
            RemotesFolder.Revive:FireServer()
        end
        return
    end

    if Camera ~= workspace.CurrentCamera then Camera = workspace.CurrentCamera end

    if Toggles.SpeedBoost.Value and GetHumanoid() and not GetCharacter():GetAttribute("Climbing") then
        if GetHumanoid().WalkSpeed ~= Speed then GetHumanoid().WalkSpeed = Speed end
    end

    if Toggles.EnableJump.Value and GetHumanoid() then
        if GetHumanoid().UseJumpPower then GetHumanoid().JumpPower = JumpPower
        else GetHumanoid().JumpHeight = JumpPower end
    end

    if Toggles.ThirdPerson.Value then
        Camera.CFrame = Camera.CFrame * CFrame.new(
            Options.ThirdPersonX.Value, Options.ThirdPersonY.Value, Options.ThirdPersonZ.Value)
    end

    Camera.FieldOfView = Options.FOV.Value

    if Toggles.NoCameraShake.Value then
        local ok, req = pcall(require, MainGame)
        if ok and req then req.csgo = CFrame.new() end
    end

    if Toggles.Noclip.Value and GetCharacter() then
        for _, v in pairs(GetCharacter():GetChildren()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
        local col = GetCharacter():FindFirstChild("Collision")
        if col then
            col.CanCollide = false
            if col:FindFirstChild("CollisionCrouch") then
                col.CollisionCrouch.CanCollide = false
            end
        end
    end

    if Toggles.AutoInteract.Value and timers.AI > 0.05 then
        timers.AI = 0
        for i = #InteractPrompts, 1, -1 do
            local p = InteractPrompts[i]
            if not p or not p.Parent then table.remove(InteractPrompts, i)
            else
                local tgt = p.Parent:IsA("BasePart") and p.Parent or p.Parent:FindFirstChildWhichIsA("BasePart")
                if tgt and DistanceTo(tgt.Position) <= p.MaxActivationDistance then
                    local ign = Options.AutoInteractIgnoreList.Value
                    if not ((p.Parent.Name == "GoldPile" and ign["Coins"])
                        or (p.Parent.Name == "GlitchCube" and ign["Glitch Cube"])
                        or (p.Parent:GetAttribute("JeffShop") and ign["Jeff Items"])) then
                        pcall(fireproximityprompt, p)
                    end
                end
            end
        end
    end

    if Toggles.AutoLibraryCode.Value and timers.Lib > 0.5 and LatestRoom.Value == 50 then
        timers.Lib = 0
        local code = GetLibraryCode()
        if code then
            if Toggles.BruteForceLibraryCode.Value and code:find("_") then
                code = code:gsub("_", function() return tostring(math.random(0, 9)) end)
            end
            RemotesFolder.PL:FireServer(code)
        end
    end

    if Toggles.NotifyLibraryCode.Value and timers.Notify > 5 and LatestRoom.Value == 50 then
        timers.Notify = 0
        local code = GetLibraryCode()
        if code and not code:find("_") then
            Notify("Padlock", "Code: " .. code, 8)
        end
    end

    if Toggles.DoorReach.Value and timers.Door > 0.2 then
        timers.Door = 0
        local room = CurrentRooms:FindFirstChild(tostring(LatestRoom.Value))
        local door = room and room:FindFirstChild("Door")
        if door and door:FindFirstChild("Door") and DistanceTo(door.Door.Position) < DoorReachRange then
            door.ClientOpen:FireServer()
        end
    end

    if Toggles.BypassEyes and Toggles.BypassEyes.Value then
        if workspace:FindFirstChild("Eyes") and not GetCharacter():GetAttribute("Hiding") then
            if RemotesFolder.Name == "RemotesFolder" then
                RemotesFolder.MotorReplication:FireServer(-650)
            end
        end
    end

    if Toggles.BypassLookman and Toggles.BypassLookman.Value then
        if workspace:FindFirstChild("BackdoorLookman") and not GetCharacter():GetAttribute("Hiding") then
            RemotesFolder.MotorReplication:FireServer(-650)
        end
    end

    if Toggles.Fullbright.Value then Lighting.Ambient = Color3.new(1, 1, 1) end

    if Toggles.NoFog.Value then
        Lighting.FogEnd = 100000
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") and v.Density > 0 then v.Density = 0 end
        end
    end

    if Toggles.Godmode and Toggles.Godmode.Value and GetCharacter() then
        local c = GetCharacter()
        if not Toggles.AntiFigureHearing.Value then Toggles.AntiFigureHearing:SetValue(true) end
        c.Collision.Size = Vector3.new(1, 0.001, 5)
        if c:FindFirstChild("LowerTorso") and c.LowerTorso:FindFirstChild("Root") then
            c.LowerTorso.Root.C1 = CFrame.new(0, -2.346, 0)
        end
        if GetHumanoid() then GetHumanoid().HipHeight = 0.05 end
    end

    if Toggles.InfiniteItems.Value then
        local char = GetCharacter()
        local tool = char and (char:FindFirstChild("Lockpick") or char:FindFirstChild("SkeletonKey")
            or char:FindFirstChild("Shears") or char:FindFirstChild("Multitool"))
        if tool then
            for _, p in pairs(CurrentRooms:GetDescendants()) do
                if p:IsA("ProximityPrompt") and p.Parent then
                    local parentName = p.Parent.Name
                    local grandName = p.Parent.Parent and p.Parent.Parent.Name
                    local isTarget = parentName == "Lock" or parentName == "ChestBoxLocked"
                        or parentName == "Cellar" or parentName == "Chest_Vine"
                        or parentName == "CuttableVines" or parentName == "SkullLock"
                        or parentName == "Toolbox_Locked" or parentName == "Lock1" or parentName == "Lock2"
                        or grandName == "Locker_Small_Locked"
                    if isTarget then
                        local tgt = p.Parent:IsA("BasePart") and p.Parent or p.Parent:FindFirstChildWhichIsA("BasePart")
                        if tgt and DistanceTo(tgt.Position) < (p.MaxActivationDistance + 5) then
                            pcall(fireproximityprompt, p)
                        end
                    end
                end
            end
        end
    end

    if Toggles.InfiniteCrucifix.Value then
        local char = GetCharacter()
        local tool = char and char:FindFirstChild("Crucifix")
        if tool then
            local ranges = { RushMoving = 90, AmbushMoving = 160, A60 = 140, A120 = 99, GlitchRush = 150, GlitchAmbush = 110 }
            local root = GetRoot()
            for _, ent in pairs(workspace:GetChildren()) do
                local maxR = ranges[ent.Name]
                if maxR and ent.PrimaryPart then
                    local d = DistanceTo(ent.PrimaryPart.Position)
                    if d < maxR + 40 then
                        InfParams.FilterDescendantsInstances = { char, ent }
                        local hit = workspace:Raycast(root.Position, ent.PrimaryPart.Position - root.Position, InfParams)
                        if not hit then
                            task.spawn(function()
                                RemotesFolder.DropItem:FireServer(tool)
                                local t0 = tick()
                                repeat
                                    task.wait(0.01)
                                    local drop = workspace:FindFirstChild("Drops")
                                    drop = drop and drop:FindFirstChild("Crucifix")
                                    local p = drop and drop:FindFirstChildOfClass("ProximityPrompt")
                                    if p then pcall(fireproximityprompt, p) end
                                until char:FindFirstChild("Crucifix") or (tick() - t0) > 1.2
                            end)
                            break
                        end
                    end
                end
            end
        end
    end

    if Toggles.Manipulation.Value and Options.ManipulationMode.Value == "Velocity" and GetRoot() then
        if not Toggles.Noclip.Value then Toggles.Noclip:SetValue(true) end
        local bv = GetRoot():FindFirstChild("BiticalMani")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "BiticalMani"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = GetRoot()
        end
        bv.Velocity = GetRoot().CFrame.LookVector * 2.25
    elseif GetRoot() and GetRoot():FindFirstChild("BiticalMani") then
        GetRoot():FindFirstChild("BiticalMani"):Destroy()
    end

    if Toggles.AntiJamming.Value and LiveModifiers and LiveModifiers:FindFirstChild("Jammin") then
        local Health = MainGame:FindFirstChild("Health")
        if Health then
            local jam = Health:FindFirstChild("Jam")
            if jam and jam.Playing then jam.Playing = false end
        end
    end
end))

