-- DESCENDANT HANDLER
-- ═══════════════════════════════════════════════════════════════

table.insert(Connections, workspace.DescendantAdded:Connect(function(v)
    local timeout = 0
    repeat task.wait(0.03) timeout += 0.03 until v.Parent or timeout > 0.5
    
    if not v.Parent then return end
    
    -- Prompt handling
    if v:IsA("ProximityPrompt") then
        if Toggles.InstantPrompt.Value then
            if not v:GetAttribute("Hold") then
                v:SetAttribute("Hold", v.HoldDuration)
            end
            v.HoldDuration = 0
        end
        
        if Toggles.PromptReach.Value then
            if not v:GetAttribute("Distance") then
                v:SetAttribute("Distance", v.MaxActivationDistance)
            end
            v.MaxActivationDistance = v:GetAttribute("Distance") * promptReachMultiplier
        end
        
        if Toggles.PromptClip.Value then
            if not v:GetAttribute("Clip") then
                v:SetAttribute("Clip", v.RequiresLineOfSight)
            end
            v.RequiresLineOfSight = false
        end
        
        if Toggles.AutoInteract.Value then
            if not (PromptIgnore[v.Name] or v.Parent.Name == "Padlock" or v.Parent:GetAttribute("JeffShop")) then
                table.insert(Interactions, v)
            end
        end
        
        if Toggles.InfiniteItems.Value and IsInfItemTarget(v) then
            table.insert(StoredPrompts, v)
        end
    end
    
    -- Anti Lag
    if Toggles.AntiLag.Value and v:IsA("BasePart") then
        if not v:GetAttribute("Mat") then
            v:SetAttribute("Mat", v.Material)
        end
        v.Material = Enum.Material.Plastic
    end
    
    -- Anti Snare
    if Toggles.AntiSnare.Value and v.Name == "Snare" then
        repeat task.wait() until v:FindFirstChild("Hitbox") or not v.Parent
        if v:FindFirstChild("Hitbox") then
            v.Hitbox.CanTouch = false
        end
    end
    
    -- Anti Giggle
    if Toggles.AntiGiggle.Value and v.Name == "GiggleCeiling" then
        repeat task.wait() until v:FindFirstChild("Hitbox") or not v.Parent
        if v:FindFirstChild("Hitbox") then
            v.Hitbox.CanTouch = false
        end
    end
    
    -- Anti Dupe
    if Toggles.AntiDupe.Value and v.Name == "DoorFake" and v.Parent.Name == "SideroomDupe" then
        local hidden = v:WaitForChild("Hidden", 5)
        if hidden then
            hidden.CanTouch = false
        end
    end
    
    -- Anti Lava
    if Toggles.AntiLava.Value and v.Name == "Lava" then
        v.CanTouch = false
    end
    
    -- Anti Seek Wall
    if Toggles.AntiSeekWall.Value and v.Name == "ScaryWall" then
        for _, i in pairs(v:GetChildren()) do
            if i:IsA("BasePart") then
                i.CanTouch = false
            end
        end
    end
    
    -- Auto Breaker
    if Toggles.AutoBreaker.Value and v.Name == "ElevatorBreaker" then
        task.spawn(function()
            local label = v:WaitForChild("SurfaceGui"):WaitForChild("Frame"):WaitForChild("Code")
            local function run()
                task.wait(0.05)
                if not Toggles.AutoBreaker.Value then return end
                local target = tonumber(label.Text)
                if target then
                    for _, sw in v:GetChildren() do
                        if sw.Name == "BreakerSwitch" and sw:GetAttribute("ID") == target then
                            local trans = label:WaitForChild("Frame").BackgroundTransparency
                            local pc = sw:FindFirstChild("PrismaticConstraint")
                            local light = sw:FindFirstChild("Light")
                            local sound = sw:FindFirstChild("Sound")
                            if trans == 0 then
                                sw:SetAttribute("Enabled", true)
                                if pc then pc.TargetPosition = -0.2 end
                                if light then light.Material = Enum.Material.Neon end
                                if sound then sound:Play() end
                            elseif trans == 1 then
                                sw:SetAttribute("Enabled", false)
                                if pc then pc.TargetPosition = 0.2 end
                                if light then light.Material = Enum.Material.Glass end
                                if sound then sound:Play() end
                            end
                            break
                        end
                    end
                end
            end
            label:GetPropertyChangedSignal("Text"):Connect(run)
            run()
        end)
    end
end))

table.insert(Connections, workspace.DescendantRemoving:Connect(function(v)
    for i, prompt in pairs(Interactions) do
        if prompt == v then
            table.remove(Interactions, i)
            break
        end
    end
    for i, prompt in pairs(StoredPrompts) do
        if prompt == v then
            table.remove(StoredPrompts, i)
            break
        end
    end
end))

